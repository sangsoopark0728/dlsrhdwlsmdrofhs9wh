# =========================

class SplashScreen(tk.Toplevel):
    def __init__(self, parent, on_done):
        super().__init__(parent)
        self.parent = parent
        self.on_done = on_done
        self.alpha = 0.0
        self.phase = "in"
        self.hold = 0

        self.overrideredirect(True)
        self.configure(bg="#0d1117")
        self.attributes("-alpha", 0.0)
        self.attributes("-topmost", True)

        w, h = 520, 320
        x = (parent.winfo_screenwidth() - w) // 2
        y = (parent.winfo_screenheight() - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")

        tk.Label(
            self,
            text="📚",
            font=("Segoe UI Emoji", 64),
            bg="#0d1117",
            fg=ACCENT
        ).pack(pady=(70, 10))

        tk.Label(
            self,
            text="Study Timer",
            font=("Georgia", 26, "bold"),
            bg="#0d1117",
            fg=TEXT
        ).pack()

        tk.Label(
            self,
            text="공부 타이머",
            font=("Malgun Gothic", 13),
            bg="#0d1117",
            fg=TEXT_DIM
        ).pack(pady=(8, 0))

        self.after(30, self.tick)

    def tick(self):
        if self.phase == "in":
            self.alpha += 0.1
            self.attributes("-alpha", min(self.alpha, 1.0))
            if self.alpha >= 1.0:
                self.phase = "hold"

        elif self.phase == "hold":
            self.hold += 1
            if self.hold >= 25:
                self.phase = "out"

        elif self.phase == "out":
            self.alpha -= 0.1
            self.attributes("-alpha", max(self.alpha, 0.0))
            if self.alpha <= 0:
                self.destroy()
                self.on_done()
                return

        self.after(30, self.tick)


