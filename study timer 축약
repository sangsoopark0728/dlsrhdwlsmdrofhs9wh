    def start_timer(self):
        if not self.subjects:
            messagebox.showwarning("과목 없음", "먼저 과목을 추가해주세요.")
            return

        start_index = self.first_pending_subject()

        if start_index is None:
            messagebox.showinfo("완료", "모든 과목이 이미 완료되었습니다.")
            return

        self.timer_running = True
        self.timer_paused = False
        self.current_subject = start_index

        self.today_view.pack_forget()
        self.weekly_view.pack_forget()
        self.tab_header.pack_forget()
        self.timer_view.pack(fill="both", expand=True)

        self.load_subject(start_index)

    def first_pending_subject(self):
        for i, subj in enumerate(self.subjects):
            if not subj.get("completed", False):
                return i
        return None

    def load_subject(self, index):
        if index >= len(self.subjects):
            self.all_done()
            return

        self.current_subject = index

        subj = self.subjects[index]
        color = subj.get("color", ACCENT)

        self.total_secs = subj["minutes"] * 60
        self.elapsed_pause = min(
            float(subj.get("elapsed_secs", 0)),
            self.total_secs
        )
        self.start_mono = time.monotonic()

        self.timer_paused = False
        self.pause_btn.config(text="⏸ 일시정지", bg=WARNING)

        char_key = subj.get("character", "turtle")
        prop_key = subj.get("prop", "box")

        char_icon, char_name = CHARACTERS.get(char_key, ("🐢", "거북이"))
        prop_icon, prop_name = PROPS.get(prop_key, ("📦", "박스"))

        self.lbl_subject_name.config(
            text=subj["name"],
            fg=color
        )

        self.lbl_subject_index.config(
            text=f"과목 {index + 1} / {len(self.subjects)}"
        )

        self.lbl_char_prop.config(
            text=f"{char_icon} {char_name} + {prop_icon} {prop_name}",
            fg=color
        )

        self.lbl_timer.config(fg=color)
        self.progress_canvas.itemconfig(self.progress_bar, fill=color)

        self.refresh_mini_schedule()
        self.render_loop()

    def elapsed(self):
        if self.timer_paused:
            return self.elapsed_pause
        return self.elapsed_pause + (time.monotonic() - self.start_mono)

    def save_current_progress(self):
        if not self.subjects:
            return

        if self.current_subject >= len(self.subjects):
            return

        subj = self.subjects[self.current_subject]
        total = subj["minutes"] * 60

        elapsed = min(self.elapsed(), total)

        subj["elapsed_secs"] = elapsed
        subj["completed"] = elapsed >= total

    def render_loop(self):
        if not self.timer_running:
            return

        elapsed = self.elapsed()
        self.save_current_progress()

        remaining = max(0, self.total_secs - elapsed)
        progress = min(elapsed / self.total_secs, 1.0) if self.total_secs else 1.0

        mins, secs = divmod(math.ceil(remaining), 60)
        self.lbl_timer.config(text=f"{mins:02d}:{secs:02d}")

        width = self.progress_canvas.winfo_width()
        self.progress_canvas.coords(
            self.progress_bar,
            0,
            0,
            width * progress,
            10
        )

        self.draw_simple_animation(progress)

        if elapsed >= self.total_secs:
            self.subject_done()
            return

        self.after(FRAME_MS, self.render_loop)

    def toggle_pause(self):
        if not self.timer_running:
            return

        if not self.timer_paused:
            self.elapsed_pause = self.elapsed()
            self.timer_paused = True
            self.pause_btn.config(text="▶ 재개", bg=SUCCESS)

        else:
            self.start_mono = time.monotonic()
            self.timer_paused = False
            self.pause_btn.config(text="⏸ 일시정지", bg=WARNING)
            self.render_loop()

    def next_subject(self):
        if not self.timer_running:
            return

        self.save_current_progress()
        self.load_subject(self.current_subject + 1)

    def subject_done(self):
        self.save_current_progress()

        self.lbl_timer.config(text="완료! ✓")
        self.draw_simple_animation(1.0)

        next_index = self.current_subject + 1

        if next_index >= len(self.subjects):
            self.after(700, self.all_done)
            return

        def ask():
            dlg = StyledDialog(
                self,
                title="다음 과목",
                message="다음 과목을 시작하시겠습니까?",
                buttons=[
                    ("예", SUCCESS, "yes"),
                    ("아니오", CARD_BG, "no")
                ],
                icon="⏭"
            )

            if dlg.result == "yes":
                self.load_subject(next_index)
            else:
                self.show_today_view()

        self.after(700, ask)

    def go_main_from_timer(self):
        if self.timer_running:
            self.save_current_progress()

        dlg = StyledDialog(
            self,
            title="메인화면으로 이동",
            message="현재 진행도를 저장하고 메인화면으로 돌아가시겠습니까?",
            buttons=[
                ("예", LIGHT_RED, "yes"),
                ("아니오", CARD_BG, "no")
            ],
            icon="⚠️"
        )

        if dlg.result == "yes":
            self.show_today_view()

    def show_today_view(self):
        self.timer_running = False
        self.timer_paused = False

        self.timer_view.pack_forget()
        self.tab_header.pack(fill="x")

        self.switch_tab("today")
        self.refresh_subject_list()

    def all_done(self):
        self.timer_running = False

        StyledDialog(
            self,
            title="공부 완료!",
            message="오늘의 공부를 모두 끝냈습니다. 수고했어요!",
            buttons=[
                ("확인", SUCCESS, "ok")
            ],
            icon="🎉"
        )

        self.show_today_view()

