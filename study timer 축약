    def refresh_mini_schedule(self):
        for w in self.mini_schedule.winfo_children():
            w.destroy()

        tk.Label(
            self.mini_schedule,
            text="시간표",
            font=("Malgun Gothic", 10),
            bg=BG,
            fg=TEXT_DIM
        ).pack(anchor="w", pady=(0, 6))

        row = tk.Frame(self.mini_schedule, bg=BG)
        row.pack(fill="x")

        for i, subj in enumerate(self.subjects):
            if i < self.current_subject:
                mark = "✓"
                fg = TEXT_DIM
            elif i == self.current_subject:
                mark = "▶"
                fg = subj.get("color", ACCENT)
            else:
                mark = "○"
                fg = BORDER

            tk.Label(
                row,
                text=f"{mark} {subj['name']}({subj['minutes']}분)",
                font=("Malgun Gothic", 9),
                bg=CARD_BG,
                fg=fg,
                padx=8,
                pady=4
            ).pack(side="left", padx=4)

    # ---------------------
    # 간단 애니메이션
    # ---------------------

    def draw_simple_animation(self, progress):
        c = self.anim_canvas
        c.delete("all")

        w = c.winfo_width() or 800
        h = c.winfo_height() or 150

        ground = h - 35
        start_x = 45
        end_x = w - 45

        subj = self.subjects[self.current_subject]
        color = subj.get("color", ACCENT)

        char_key = subj.get("character", "turtle")
        prop_key = subj.get("prop", "box")

        char_icon = CHARACTERS.get(char_key, ("🐢", ""))[0]
        prop_icon = PROPS.get(prop_key, ("📦", ""))[0]

        x = start_x + (end_x - start_x) * progress

        c.create_rectangle(
            0,
            ground,
            w,
            h,
            fill="#1a2e1a",
            outline=""
        )

        c.create_line(
            start_x,
            ground,
            end_x,
            ground,
            fill=BORDER,
            width=3
        )

        c.create_text(
            start_x,
            ground + 16,
            text="START",
            fill=TEXT_DIM,
            font=("Courier New", 8, "bold")
        )

        c.create_text(
            end_x,
            ground + 16,
            text="END",
            fill=color,
            font=("Courier New", 8, "bold")
        )

        c.create_oval(
            x - 22,
            ground - 5,
            x + 22,
            ground + 5,
            fill="#0a1010",
            outline=""
        )

        c.create_text(
            x,
            ground - 34,
            text=char_icon,
            font=("Segoe UI Emoji", 32)
        )

        c.create_text(
            min(x + 45, end_x),
            ground - 30,
            text=prop_icon,
            font=("Segoe UI Emoji", 26)
        )

