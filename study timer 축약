        super().__init__()

        self.title("📚 Study Timer")
        self.geometry("1200x750")
        self.configure(bg=BG)

        self.subjects = []
        self.weekly_plan = {k: [] for k in DAY_KEYS}

        self.character = tk.StringVar(value="turtle")
        self.prop = tk.StringVar(value="box")

        self.current_tab = tk.StringVar(value="today")
        self.selected_day = tk.StringVar(value="mon")

        self.timer_running = False
        self.timer_paused = False

        self.current_subject = 0
        self.total_secs = 0
        self.elapsed_pause = 0
        self.start_mono = 0

        self.load_weekly_plan()

        self.build_ui()
        self.show_splash()

    # ---------------------
    # 저장 / 불러오기
    # ---------------------

    def load_weekly_plan(self):
        try:
            with open(get_save_path(), "r", encoding="utf-8") as f:
                data = json.load(f)

            for k in DAY_KEYS:
                if k in data:
                    self.weekly_plan[k] = data[k]

        except:
            pass

    def save_weekly_plan(self):
        with open(
            get_save_path(),
            "w",
            encoding="utf-8"
        ) as f:
            json.dump(
                self.weekly_plan,
                f,
                ensure_ascii=False,
                indent=2
            )

