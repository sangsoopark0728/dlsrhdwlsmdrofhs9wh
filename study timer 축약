    def build_weekly_view(self):
        self.weekly_view = tk.Frame(self.main, bg=BG)

        header = tk.Frame(self.weekly_view, bg=BG)
        header.pack(fill="x", padx=32, pady=(24, 0))

        tk.Label(
            header,
            text="주간 계획표",
            font=("Georgia", 22, "bold"),
            bg=BG,
            fg=TEXT
        ).pack(anchor="w")

        tk.Label(
            header,
            text="요일을 선택하고 왼쪽에서 과목을 추가하세요.",
            font=("Malgun Gothic", 11),
            bg=BG,
            fg=TEXT_DIM
        ).pack(anchor="w", pady=(4, 0))

