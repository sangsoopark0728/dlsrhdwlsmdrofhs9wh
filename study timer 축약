        for dk, kr in zip(DAY_KEYS, DAYS_KR):
            btn = tk.Button(
                day_frame,
                text=kr,
                font=("Malgun Gothic", 12, "bold"),
                bg=CARD_BG,
                fg=TEXT_DIM,
                relief="flat",
                cursor="hand2",
