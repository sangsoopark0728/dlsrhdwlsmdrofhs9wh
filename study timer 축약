            self.day_buttons[dk] = btn

        self.weekly_content = tk.Frame(self.weekly_view, bg=BG)
        self.weekly_content.pack(fill="both", expand=True, padx=32, pady=10)

        self.select_day("mon")

    def select_day(self, day):
        self.selected_day.set(day)

        for dk, btn in self.day_buttons.items():
            if dk == day:
                btn.config(bg=ACCENT, fg="#000000")
            else:
                btn.config(bg=CARD_BG, fg=TEXT_DIM)

        self.refresh_weekly_view()

    def refresh_weekly_view(self):
        for w in self.weekly_content.winfo_children():
            w.destroy()

        day = self.selected_day.get()
        day_index = DAY_KEYS.index(day)
        kr = DAYS_KR[day_index]

        subjects = self.weekly_plan[day]
        total = sum(s["minutes"] for s in subjects)

        tk.Label(
            self.weekly_content,
            text=f"{kr}요일 계획  |  총 {total}분",
            font=("Malgun Gothic", 16, "bold"),
            bg=BG,
            fg=ACCENT
        ).pack(anchor="w", pady=(0, 15))

        if not subjects:
            tk.Label(
                self.weekly_content,
                text=f"아직 {kr}요일 계획이 없습니다.",
                font=("Malgun Gothic", 13),
                bg=BG,
                fg=TEXT_DIM
            ).pack(pady=60)
            return

        for i, subj in enumerate(subjects):
            self.subject_card(
                parent=self.weekly_content,
                subj=subj,
                index=i,
                removable=True,
                weekly_day=day
            )

    # ---------------------
    # 과목 추가 / 삭제
    # ---------------------

    def add_subject(self):
        name = self.entry_subject.get().strip()
        minutes = self.entry_minutes.get().strip()

        if not name:
            messagebox.showwarning("입력 오류", "과목명을 입력해주세요.")
            return

        try:
            minutes = int(minutes)
            if minutes <= 0:
                raise ValueError
        except ValueError:
            messagebox.showwarning("입력 오류", "공부 시간은 양수로 입력해주세요.")
            return

        data = {
            "name": name,
            "minutes": minutes,
            "character": self.character.get(),
            "prop": self.prop.get(),
        }

        if self.current_tab.get() == "today":
            data["color"] = SUBJECT_COLORS[len(self.subjects) % len(SUBJECT_COLORS)]
            data["elapsed_secs"] = 0
            data["completed"] = False

            self.subjects.append(data)
            self.refresh_subject_list()

        else:
            day = self.selected_day.get()
            data["color"] = SUBJECT_COLORS[len(self.weekly_plan[day]) % len(SUBJECT_COLORS)]

            self.weekly_plan[day].append(data)
            self.save_weekly_plan()
            self.refresh_weekly_view()

        self.entry_subject.delete(0, "end")
        self.entry_minutes.delete(0, "end")

    def remove_subject(self, index):
        if self.timer_running:
            messagebox.showinfo("안내", "타이머 실행 중에는 삭제할 수 없습니다.")
            return

        self.subjects.pop(index)

        for i, s in enumerate(self.subjects):
            s["color"] = SUBJECT_COLORS[i % len(SUBJECT_COLORS)]

        self.refresh_subject_list()

    def remove_weekly_subject(self, day, index):
        self.weekly_plan[day].pop(index)

        for i, s in enumerate(self.weekly_plan[day]):
            s["color"] = SUBJECT_COLORS[i % len(SUBJECT_COLORS)]

        self.save_weekly_plan()
        self.refresh_weekly_view()

    # ---------------------
    # 과목 카드 공통 함수
    # ---------------------

    def subject_card(self, parent, subj, index, removable=False, weekly_day=None):
        card = tk.Frame(
            parent,
            bg=CARD_BG,
            highlightthickness=1,
            highlightbackground=BORDER
        )
        card.pack(fill="x", pady=5)

        color = subj.get("color", ACCENT)

        tk.Frame(
            card,
            bg=color,
            width=6
        ).pack(side="left", fill="y")

        body = tk.Frame(
            card,
            bg=CARD_BG,
            padx=16,
            pady=12
        )
        body.pack(side="left", fill="both", expand=True)

        row1 = tk.Frame(body, bg=CARD_BG)
        row1.pack(fill="x")

        tk.Label(
            row1,
            text=f"{index + 1:02d}.",
            font=("Courier New", 14, "bold"),
            bg=CARD_BG,
            fg=color,
            width=3,
            anchor="w"
        ).pack(side="left")

        tk.Label(
            row1,
            text=subj["name"],
            font=("Malgun Gothic", 14, "bold"),
            bg=CARD_BG,
            fg=TEXT
        ).pack(side="left", padx=6)

        if removable:
            if weekly_day:
                cmd = lambda: self.remove_weekly_subject(weekly_day, index)
            else:
                cmd = lambda: self.remove_subject(index)

            tk.Button(
                row1,
                text="✕",
                font=("Malgun Gothic", 10, "bold"),
                bg=CARD_BG,
                fg=DANGER,
                activebackground=CARD_BG,
                relief="flat",
                cursor="hand2",
                bd=0,
                command=cmd
            ).pack(side="right")

        row2 = tk.Frame(body, bg=CARD_BG)
        row2.pack(fill="x", pady=(7, 0))

        tk.Label(
            row2,
            text=f"⏱ {subj['minutes']}분",
            font=("Malgun Gothic", 11),
            bg=CARD_BG,
            fg=TEXT_DIM
        ).pack(side="left")

        if "elapsed_secs" in subj:
            total_secs = subj["minutes"] * 60
            elapsed = subj.get("elapsed_secs", 0)
            progress = min(elapsed / total_secs, 1.0) if total_secs else 0

            if subj.get("completed"):
