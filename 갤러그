# ── 별 배경 ──────────────────────────────────────────────────────────────────
class Star:
    def __init__(self):
        self.reset(random.randint(0, HEIGHT))

    def reset(self, y=0):
        self.x = random.randint(0, WIDTH)
        self.y = y
        self.speed = random.uniform(0.5, 2.5)
        self.size  = random.randint(1, 3)
        v = random.randint(150, 255)
        self.color = (v, v, min(255, v + 40))

    def update(self):
        self.y += self.speed
        if self.y > HEIGHT:
            self.reset()

    def draw(self, surf):
        pygame.draw.circle(surf, self.color, (int(self.x), int(self.y)), self.size)

stars = [Star() for _ in range(120)]

# ── 총알 ─────────────────────────────────────────────────────────────────────
class Bullet:
    def __init__(self, x, y, dy=-10, color=CYAN, w=3, h=12):
        self.x, self.y = x, y
        self.dy = dy
        self.color = color
        self.w, self.h = w, h
        self.alive = True

    def update(self):
        self.y += self.dy
        if self.y < -20 or self.y > HEIGHT + 20:
            self.alive = False

    def draw(self, surf):
        pygame.draw.rect(surf, self.color,
                         (self.x - self.w//2, self.y - self.h//2, self.w, self.h),
                         border_radius=2)
        # 빛나는 효과
        glow = (*self.color, 80)
        s = pygame.Surface((self.w+6, self.h+6), pygame.SRCALPHA)
        pygame.draw.rect(s, glow, (0, 0, self.w+6, self.h+6), border_radius=3)
        surf.blit(s, (self.x - self.w//2 - 3, self.y - self.h//2 - 3))

    def get_rect(self):
        return pygame.Rect(self.x - self.w//2, self.y - self.h//2, self.w, self.h)

# ── 폭발 파티클 ──────────────────────────────────────────────────────────────
class Particle:
    def __init__(self, x, y, color):
        self.x, self.y = x, y
        angle = random.uniform(0, 2*math.pi)
        speed = random.uniform(1, 6)
        self.vx = math.cos(angle) * speed
        self.vy = math.sin(angle) * speed
        self.color = color
        self.life  = random.randint(20, 45)
        self.size  = random.randint(2, 5)

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.vy += 0.1
        self.life -= 1

    def draw(self, surf):
        alpha = max(0, int(255 * self.life / 45))
        s = pygame.Surface((self.size*2, self.size*2), pygame.SRCALPHA)
        pygame.draw.circle(s, (*self.color, alpha), (self.size, self.size), self.size)
        surf.blit(s, (int(self.x) - self.size, int(self.y) - self.size))

particles = []

def explode(x, y, color, n=18):
    for _ in range(n):
        particles.append(Particle(x, y, color))

# ── 플레이어 ──────────────────────────────────────────────────────────────────
def draw_player(surf, x, y, scale=1.0):
    """갤러그 스타일 전투기"""
    s = int(20 * scale)
    pts = [
        (x, y - s),
        (x - s*0.6, y + s*0.5),
        (x - s*0.2, y + s*0.2),
        (x, y + s*0.6),
        (x + s*0.2, y + s*0.2),
        (x + s*0.6, y + s*0.5),
    ]
    pygame.draw.polygon(surf, CYAN, pts)
    pygame.draw.polygon(surf, WHITE, pts, 1)
    # 엔진 불꽃
    flame_h = int(s * 0.5)
    pygame.draw.polygon(surf, YELLOW, [
        (x - s*0.15, y + s*0.6),
        (x, y + s*0.6 + flame_h),
        (x + s*0.15, y + s*0.6),
    ])

class Player:
    SPEED     = 5
    SHOOT_CD  = 18   # 프레임
    MAX_HP    = 3
    SIZE      = 20

    def __init__(self):
        self.x  = WIDTH // 2
        self.y  = HEIGHT - 80
        self.hp = self.MAX_HP
        self.shoot_timer = 0
        self.invincible  = 0   # 피격 후 무적 프레임
        self.alive = True
        self.scale = 1.0

    def update(self, bullets):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT]  or keys[pygame.K_a]: self.x -= self.SPEED
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]: self.x += self.SPEED
        if keys[pygame.K_UP]    or keys[pygame.K_w]: self.y -= self.SPEED
        if keys[pygame.K_DOWN]  or keys[pygame.K_s]: self.y += self.SPEED
        self.x = max(self.SIZE, min(WIDTH - self.SIZE, self.x))
        self.y = max(HEIGHT//2, min(HEIGHT - self.SIZE, self.y))

        self.shoot_timer = max(0, self.shoot_timer - 1)
        if (keys[pygame.K_SPACE] or keys[pygame.K_z]) and self.shoot_timer == 0:
            bullets.append(Bullet(self.x - 8, self.y - 10))
            bullets.append(Bullet(self.x + 8, self.y - 10))
            self.shoot_timer = self.SHOOT_CD

        if self.invincible > 0:
            self.invincible -= 1

    def get_rect(self):
        return pygame.Rect(self.x - self.SIZE, self.y - self.SIZE,
                           self.SIZE*2, self.SIZE*2)

    def hit(self):
        if self.invincible > 0:
            return
        self.hp -= 1
        self.invincible = 90
        explode(self.x, self.y, CYAN, 10)
        if self.hp <= 0:
            self.alive = False
            explode(self.x, self.y, WHITE, 30)

    def draw(self, surf):
        if self.invincible > 0 and (self.invincible // 6) % 2 == 0:
            return  # 깜빡
        draw_player(surf, self.x, self.y)

# ── 적 ───────────────────────────────────────────────────────────────────────
ENEMY_TYPES = {
    "bee":     {"color": YELLOW, "hp": 1, "score": 50,  "size": 14},
    "moth":    {"color": PINK,   "hp": 2, "score": 100, "size": 16},
    "boss":    {"color": RED,    "hp": 4, "score": 400, "size": 20},
    "escort":  {"color": GREEN,  "hp": 1, "score": 80,  "size": 14},
}

def draw_enemy(surf, etype, x, y, t):
    cfg  = ENEMY_TYPES[etype]
    col  = cfg["color"]
    size = cfg["size"]
    bob  = math.sin(t * 0.05) * 2

    if etype == "bee":
        pts = [
            (x, y - size + bob),
            (x - size*0.7, y + size*0.3 + bob),
            (x, y + bob),
            (x + size*0.7, y + size*0.3 + bob),
        ]
        pygame.draw.polygon(surf, col, pts)
        pygame.draw.polygon(surf, WHITE, pts, 1)
        # 눈
        pygame.draw.circle(surf, WHITE, (int(x-4), int(y-2+bob)), 3)
        pygame.draw.circle(surf, WHITE, (int(x+4), int(y-2+bob)), 3)
        pygame.draw.circle(surf, BLACK, (int(x-4), int(y-2+bob)), 2)
        pygame.draw.circle(surf, BLACK, (int(x+4), int(y-2+bob)), 2)

    elif etype == "moth":
        for sign in (-1, 1):
            wing = [
                (x, y + bob),
                (x + sign*size, y - size*0.3 + bob),
                (x + sign*size*0.8, y + size*0.6 + bob),
            ]
            pygame.draw.polygon(surf, col, wing)
            pygame.draw.polygon(surf, WHITE, wing, 1)
        pygame.draw.circle(surf, col, (int(x), int(y+bob)), int(size*0.4))
        pygame.draw.circle(surf, WHITE, (int(x), int(y+bob)), int(size*0.4), 1)

    elif etype == "boss":
        outer = [
            (x, y - size + bob),
            (x - size*0.6, y - size*0.3 + bob),
            (x - size, y + size*0.3 + bob),
            (x - size*0.5, y + size + bob),
            (x + size*0.5, y + size + bob),
            (x + size, y + size*0.3 + bob),
            (x + size*0.6, y - size*0.3 + bob),
        ]
        pygame.draw.polygon(surf, RED, outer)
        pygame.draw.polygon(surf, ORANGE, outer, 2)
        pygame.draw.circle(surf, YELLOW, (int(x), int(y+bob)), int(size*0.4))
        # 복안
        for ox in (-7, 7):
            pygame.draw.circle(surf, WHITE, (int(x+ox), int(y-4+bob)), 4)
            pygame.draw.circle(surf, BLACK, (int(x+ox), int(y-4+bob)), 2)

    elif etype == "escort":
        pts = [
            (x, y - size + bob),
            (x - size*0.8, y + size*0.6 + bob),
            (x, y + size*0.2 + bob),
            (x + size*0.8, y + size*0.6 + bob),
        ]
        pygame.draw.polygon(surf, col, pts)
        pygame.draw.polygon(surf, WHITE, pts, 1)

class Enemy:
    SHOOT_PROB = 0.003   # 프레임당 발사 확률

    def __init__(self, etype, gx, gy, wave=1):
        self.etype = etype
        cfg = ENEMY_TYPES[etype]
        self.hp    = cfg["hp"] + (wave - 1)
        self.score = cfg["score"]
        self.size  = cfg["size"]
        self.color = cfg["color"]

        # 그리드 목표 위치
        self.gx, self.gy = gx, gy
        # 입장 경로 (화면 위에서 내려옴)
        self.x = random.randint(40, WIDTH-40)
        self.y = -40
        self.entering = True

        # 다이브 공격
        self.diving  = False
        self.dive_pts = []
        self.dive_i   = 0

        self.t     = random.randint(0, 100)
        self.alive = True

    def update(self, e_bullets, wave):
        self.t += 1

        if self.entering:
            dx = self.gx - self.x
            dy = self.gy - self.y
            dist = math.hypot(dx, dy)
            speed = 4
            if dist < speed:
                self.x, self.y = self.gx, self.gy
                self.entering = False
            else:
                self.x += dx/dist * speed
                self.y += dy/dist * speed
            return

        if self.diving:
            if self.dive_i < len(self.dive_pts):
                tx, ty = self.dive_pts[self.dive_i]
                dx, dy = tx - self.x, ty - self.y
                dist = math.hypot(dx, dy)
                if dist < 5:
                    self.dive_i += 1
                else:
                    spd = 5 + wave * 0.3
                    self.x += dx/dist * spd
                    self.y += dy/dist * spd
            else:
                # 다이브 끝 → 그리드로 복귀
                self.diving = False
                self.entering = True
            return

        # 그리드 호버
        self.x = self.gx + math.sin(self.t * 0.04) * 6
        self.y = self.gy + math.cos(self.t * 0.03) * 3

        # 랜덤 발사
        prob = self.SHOOT_PROB * (1 + wave * 0.15)
        if random.random() < prob:
            e_bullets.append(Bullet(self.x, self.y + self.size, dy=5+wave*0.5,
                                    color=ORANGE, w=4, h=14))

        # 랜덤 다이브
        if random.random() < 0.0008 and not self.diving:
            self._start_dive()

    def _start_dive(self):
        self.diving = True
        self.dive_i = 0
        # 베지어 경로 생성
        cx1 = random.randint(50, WIDTH-50)
        cy1 = HEIGHT * 0.5
        ex  = random.randint(50, WIDTH-50)
        ey  = HEIGHT + 60
        pts = []
        for i in range(40):
            r = i / 39
            # 2차 베지어
            bx = (1-r)**2*self.x + 2*(1-r)*r*cx1 + r**2*ex
            by = (1-r)**2*self.y + 2*(1-r)*r*cy1 + r**2*ey
            pts.append((bx, by))
        self.dive_pts = pts

    def hit(self):
        self.hp -= 1
        if self.hp <= 0:
            self.alive = False
            explode(self.x, self.y, self.color)
            return True
        return False

    def get_rect(self):
        s = self.size
        return pygame.Rect(self.x - s, self.y - s, s*2, s*2)

    def draw(self, surf):
        draw_enemy(surf, self.etype, self.x, self.y, self.t)

# ── 웨이브 생성 ───────────────────────────────────────────────────────────────
GRID_ROWS = 5
GRID_COLS = 10
GRID_X0   = 40
GRID_Y0   = 80
GRID_DX   = (WIDTH - GRID_X0*2) // (GRID_COLS - 1)
GRID_DY   = 44

def make_wave(wave):
    enemies = []
    row_types = ["boss", "moth", "moth", "bee", "bee"]
    for row in range(GRID_ROWS):
        etype = row_types[row]
        if row == 0 and wave < 2:
            etype = "moth"
        cols = GRID_COLS if etype != "boss" else 6
        x0 = (WIDTH - (cols - 1) * GRID_DX) // 2
        for col in range(cols):
            gx = x0 + col * GRID_DX
            gy = GRID_Y0 + row * GRID_DY
            enemies.append(Enemy(etype, gx, gy, wave))
    return enemies

# ── HUD 그리기 ────────────────────────────────────────────────────────────────
def draw_hud(surf, score, hi_score, wave, player):
    # 점수
    sc = font_small.render(f"SCORE  {score:07d}", True, WHITE)
    surf.blit(sc, (10, 8))
    hi = font_small.render(f"HI  {hi_score:07d}", True, YELLOW)
    surf.blit(hi, (WIDTH - hi.get_width() - 10, 8))
    wv = font_small.render(f"STAGE {wave}", True, CYAN)
    surf.blit(wv, (WIDTH//2 - wv.get_width()//2, 8))

    # 목숨
    for i in range(player.hp):
        draw_player(surf, 18 + i*28, HEIGHT - 20, scale=0.6)

    # 구분선
    pygame.draw.line(surf, GRAY, (0, 28), (WIDTH, 28), 1)
    pygame.draw.line(surf, GRAY, (0, HEIGHT-38), (WIDTH, HEIGHT-38), 1)

# ── 화면 전환 ─────────────────────────────────────────────────────────────────
def draw_title(surf, hi_score):
    surf.fill(DARK_BLUE)
    for s in stars: s.draw(surf)

    t = font_big.render("GALAGA", True, YELLOW)
    surf.blit(t, (WIDTH//2 - t.get_width()//2, 180))
    sub = font_med.render("PYTHON EDITION", True, CYAN)
    surf.blit(sub, (WIDTH//2 - sub.get_width()//2, 240))

    hi = font_small.render(f"HI SCORE  {hi_score:07d}", True, WHITE)
    surf.blit(hi, (WIDTH//2 - hi.get_width()//2, 300))

    blink = (pygame.time.get_ticks() // 500) % 2
    if blink:
        st = font_med.render("PRESS ENTER", True, GREEN)
        surf.blit(st, (WIDTH//2 - st.get_width()//2, 400))

    ctrl = [
        "Arrow Keys / WASD : Move",
        "Space / Z         : Fire",
        "ESC               : Quit",
    ]
    for i, c in enumerate(ctrl):
        ln = font_small.render(c, True, GRAY)
        surf.blit(ln, (WIDTH//2 - ln.get_width()//2, 480 + i*24))

def draw_wave_banner(surf, wave):
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 140))
    surf.blit(overlay, (0, 0))
    t1 = font_med.render(f"- STAGE  {wave} -", True, YELLOW)
    surf.blit(t1, (WIDTH//2 - t1.get_width()//2, HEIGHT//2 - 20))

def draw_gameover(surf, score, hi_score):
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 180))
    surf.blit(overlay, (0, 0))
    t1 = font_big.render("GAME OVER", True, RED)
    surf.blit(t1, (WIDTH//2 - t1.get_width()//2, 240))
    t2 = font_med.render(f"SCORE : {score:07d}", True, WHITE)
    surf.blit(t2, (WIDTH//2 - t2.get_width()//2, 320))
    if score >= hi_score:
        t3 = font_med.render("NEW HI SCORE!", True, YELLOW)
        surf.blit(t3, (WIDTH//2 - t3.get_width()//2, 370))
    blink = (pygame.time.get_ticks() // 500) % 2
    if blink:
        t4 = font_small.render("PRESS ENTER TO RETRY  /  ESC TO QUIT", True, CYAN)
        surf.blit(t4, (WIDTH//2 - t4.get_width()//2, 440))

# ── 메인 루프 ─────────────────────────────────────────────────────────────────
def main():
    hi_score = 0
    state = "title"   # title / wave_banner / playing / gameover

    score     = 0
    wave      = 1
    player    = Player()
    enemies   = []
    p_bullets = []   # 플레이어 총알
    e_bullets = []   # 적 총알
    banner_timer = 0

    while True:
        clock.tick(FPS)

        # ── 이벤트 ───────────────────────────────────────────────────────────
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_ESCAPE:
                    pygame.quit(); sys.exit()

                if state == "title" and ev.key == pygame.K_RETURN:
                    score     = 0
                    wave      = 1
                    player    = Player()
                    enemies   = make_wave(wave)
                    p_bullets = []
                    e_bullets = []
                    banner_timer = 120
                    state = "wave_banner"

                elif state == "gameover" and ev.key == pygame.K_RETURN:
                    state = "title"

        # ── 별 업데이트 ──────────────────────────────────────────────────────
        for s in stars: s.update()

        # ── 상태별 업데이트 ──────────────────────────────────────────────────
        if state == "wave_banner":
            banner_timer -= 1
            if banner_timer <= 0:
                state = "playing"

        elif state == "playing":
            player.update(p_bullets)

            for b in p_bullets: b.update()
            p_bullets = [b for b in p_bullets if b.alive]

            for b in e_bullets: b.update()
            e_bullets = [b for b in e_bullets if b.alive]

            for e in enemies:
                e.update(e_bullets, wave)

            # 충돌: 플레이어 총알 ↔ 적
            for b in p_bullets[:]:
                br = b.get_rect()
                for e in enemies:
                    if b.alive and br.colliderect(e.get_rect()):
                        b.alive = False
                        if e.hit():
                            score += e.score
                        break

            # 충돌: 적 총알 ↔ 플레이어
            for b in e_bullets[:]:
                if b.alive and b.get_rect().colliderect(player.get_rect()):
                    b.alive = False
                    player.hit()

            # 충돌: 적 ↔ 플레이어 (다이브)
            for e in enemies:
                if e.diving and e.get_rect().colliderect(player.get_rect()):
                    player.hit()

            # 파티클
            for p in particles: p.update()
            particles[:] = [p for p in particles if p.life > 0]

            # 적 전멸 → 다음 웨이브
            enemies = [e for e in enemies if e.alive]
            if not enemies:
                wave += 1
                enemies   = make_wave(wave)
                e_bullets = []
                banner_timer = 120
                state = "wave_banner"

            # 플레이어 사망
            if not player.alive:
                hi_score = max(hi_score, score)
                state = "gameover"

        # ── 그리기 ───────────────────────────────────────────────────────────
        screen.fill(DARK_BLUE)
        for s in stars: s.draw(screen)

        if state == "title":
            draw_title(screen, hi_score)

        elif state in ("wave_banner", "playing"):
            # 적
            for e in enemies: e.draw(screen)
            # 총알
            for b in p_bullets: b.draw(screen)
            for b in e_bullets: b.draw(screen)
            # 파티클
            for p in particles: p.draw(screen)
            # 플레이어
            player.draw(screen)
            # HUD
            draw_hud(screen, score, hi_score, wave, player)

            if state == "wave_banner":
                draw_wave_banner(screen, wave)

        elif state == "gameover":
            for e in enemies: e.draw(screen)
            for p in particles: p.update(); p.draw(screen)
            draw_hud(screen, score, hi_score, wave, player)
            draw_gameover(screen, score, hi_score)

        pygame.display.flip()

if __name__ == "__main__":
    main()
